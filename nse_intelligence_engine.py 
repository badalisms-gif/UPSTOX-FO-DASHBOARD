
import io
import zipfile
import requests
import pandas as pd
import streamlit as st

from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

IST = ZoneInfo("Asia/Kolkata")

NSE = "https://www.nseindia.com"
ARC = "https://nsearchives.nseindia.com"
UP = "https://api.upstox.com"

HEADERS = {
    "User-Agent": "FNO-Data-Research/4.0",
    "Accept": "application/json, text/plain, */*"
}


def now():
    return datetime.now(IST)


def result(source, rows=None, error=""):
    rows = rows if rows is not None else []

    return {
        "source": source,
        "available": not bool(error),
        "records": len(rows),
        "items": rows,
        "error": error,
        "checked": now().isoformat()
    }


def get_json(url, params=None, headers=None):

    with requests.Session() as s:

        r = s.get(
            url,
            params=params,
            headers=headers or HEADERS,
            timeout=(5, 12),
            allow_redirects=False
        )

        if r.status_code != 200:
            raise RuntimeError(
                f"HTTP {r.status_code}"
            )

        return r.json()


def extract_rows(data):

    if isinstance(data, list):
        rows = data

    elif isinstance(data, dict):

        rows = None

        for key in (
            "data",
            "Table",
            "bulkDeals",
            "blockDeals",
            "bulk_deals",
            "block_deals"
        ):

            if isinstance(data.get(key), list):
                rows = data[key]
                break

        if rows is None:
            raise ValueError("Unknown response schema")

    else:
        raise ValueError("Invalid response")

    if not all(isinstance(x, dict) for x in rows):
        raise ValueError("Invalid record schema")

    return rows


@st.cache_data(ttl=300, show_spinner=False)
def announcements():

    try:

        data = get_json(
            NSE + "/api/corporate-announcements",
            {"index": "equities"}
        )

        rows = extract_rows(data)

        return result(
            "NSE Announcements",
            rows
        )

    except Exception as e:

        return result(
            "NSE Announcements",
            error=str(e)
        )


@st.cache_data(ttl=300, show_spinner=False)
def pre_open():

    try:

        data = get_json(
            NSE + "/api/market-data-pre-open",
            {"key": "FO"}
        )

        return result(
            "NSE Pre Open",
            extract_rows(data)
        )

    except Exception as e:

