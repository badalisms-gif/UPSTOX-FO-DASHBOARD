# NSE DELIVERY DATA
# =====================================

@st.cache_data(
    ttl=3600,
    show_spinner=False
)
def delivery(date):

    d = date.strftime("%d%m%Y")

    url = (
        ARC
        + "/products/content/"
        + f"sec_bhavdata_full_{d}.csv"
    )

    try:

        df = download_report(url)

        required = {
            "SYMBOL",
            "DELIV_QTY"
        }

        if not required.issubset(df.columns):

            raise ValueError(
                "Schema mismatch"
            )

        date_col = next(
            (
                c for c in (
                    "DATE1",
                    "DATE",
                    "TRADDT"
                )
                if c in df.columns
            ),
            None
        )

        if date_col is None:

            raise ValueError(
                "Date column missing"
            )

        dates = pd.to_datetime(
            df[date_col],
            dayfirst=True,
            errors="coerce"
        ).dt.date

        if (
            df.empty
            or not dates.eq(date).all()
        ):

            raise ValueError(
                "Report date mismatch"
            )

        return {
            "source": "NSE Delivery",
            "available": True,
            "records": len(df),
            "date": str(date),
            "data": df,
            "error": "",
            "checked": now().isoformat()
        }

    except Exception as exc:

        return {
            "source": "NSE Delivery",
            "available": False,
            "records": 0,
            "date": str(date),
            "data": pd.DataFrame(),
            "error": str(exc),
            "checked": now().isoformat()
        }


# =====================================
# SHORT SELLING CSV VALIDATION
# =====================================

def short_selling_csv(upload):

    if upload is None:

        return {
            "available": False,
            "records": 0,
            "data": pd.DataFrame(),
            "error": "Official CSV required"
        }

    try:

        upload.seek(0)

        df = pd.read_csv(upload)

        df.columns = [
            str(c).strip().upper()
            for c in df.columns
        ]

        symbol_col = next(
            (
                c for c in df.columns
                if c in (
                    "SYMBOL",
                    "SECURITY SYMBOL"
                )
            ),
            None
        )

        qty_col = next(
            (
                c for c in df.columns
                if "QTY" in c
                or "QUANTITY" in c
            ),
            None
        )

        date_col = next(
            (
                c for c in df.columns
                if "DATE" in c
            ),
            None
        )

        if not all(
            [
                symbol_col,
                qty_col,
                date_col
            ]
        ):

            raise ValueError(
                "Unrecognized short selling schema"
            )

        df["REPORT_DATE"] = pd.to_datetime(
            df[date_col],
            dayfirst=True,
            errors="coerce"
        ).dt.date

        df["SHORT_QTY"] = pd.to_numeric(
            df[qty_col].astype(str)
            .str.replace(
                ",",
                "",
                regex=False
            ),
            errors="coerce"
        )

        df["STOCK_SYMBOL"] = (
            df[symbol_col]
            .astype("string")
            .str.strip()
            .str.upper()
        )

        if (
            df.empty
            or df["REPORT_DATE"].isna().any()
            or df["SHORT_QTY"].isna().any()
            or df["STOCK_SYMBOL"].isna().any()
            or df["STOCK_SYMBOL"].eq("").any()
            or (df["SHORT_QTY"] < 0).any()
            or (
                df["REPORT_DATE"] > now().date()
            ).any()
        ):

            raise ValueError(
                "Invalid short selling records"
            )

        return {
            "available": True,
            "records": len(df),
            "data": df,
            "error": "",
            "date": str(
                df["REPORT_DATE"].max()
            )
        }

    except Exception as exc:

        return {
            "available": False,
            "records": 0,
            "data": pd.DataFrame(),
            "error": str(exc)
        }


# =====================================
# UPSTOX COMPANY NEWS
# =====================================

def upstox_news(
    token,
    instrument_keys
):

    if not token:

        return result(
            "Upstox News",
            error="Access token required"
        )

    keys = list(
        dict.fromkeys(instrument_keys)
    )

    if not keys:

        return result(
            "Upstox News",
            error="No instruments"
        )

    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/json"
    }

    rows = []

    errors = []

    for i in range(0, len(keys), 30):

        batch = keys[i:i + 30]

        try:

            complete = False

            for page in range(1, 4):

                data = get_json(
                    UP + "/v2/news",
                    {
                        "category":
                            "instrument_keys",

                        "instrument_keys":
                            ",".join(batch),

                        "page_number": page,

                        "page_size": 100
                    },
                    headers
                )

                if not isinstance(data, dict):

                    raise ValueError(
                        "Invalid news response"
                    )

                mapping = data.get(
                    "data",
                    {}
                )

                if (
                    data.get("status") != "success"
                    or not isinstance(mapping, dict)
                ):

                    raise ValueError(
                        "Invalid news response"
                    )

                for key, articles in mapping.items():

                    if key not in batch:

                        continue

                    if not isinstance(
                        articles,
                        list
                    ):

                        continue

                    for article in articles:

                        if not isinstance(
                            article,
                            dict
                        ):

                            continue

                        rows.append({
                            "Instrument": key,

                            "Heading": article.get(
                                "heading",
                                ""
                            ),

                            "Summary": article.get(
                                "summary",
                                ""
                            ),

                            "Published": article.get(
                                "published_time"
                            ),

                            "URL": article.get(
                                "article_link",
                                ""
                            ),

                            "Impact":
                                "REVIEW REQUIRED"
                        })

                pages = data.get(
                    "metadata",
                    {}
                ).get(
                    "page",
                    {}
                ).get(
                    "total_pages"
                )

                if pages is not None:

                    if page >= int(pages):

                        complete = True

                        break

                else:

                    break

            if not complete:

                errors.append(
                    f"Batch {i // 30 + 1}: "
                    "Pagination unverified"
                )

        except Exception as exc:

            message = str(exc).replace(
                token,
                "[REDACTED]"
            )

            errors.append(
                f"Batch {i // 30 + 1}: "
                f"{type(exc).__name__}: "
                + message
            )

    if rows:

        df = pd.DataFrame(rows)

        df = df.drop_duplicates(
            subset=[
                "Instrument",
                "Heading",
                "Published"
            ]
        )

        rows = df.to_dict(
            "records"
        )

    return result(
        "Upstox News",
        rows,
        "; ".join(errors)
    )


# =====================================
# SOURCE COVERAGE REPORT
# =====================================

def render_source_coverage(feeds):

    if not feeds:

        return

    rows = []

    for feed in feeds:

        if feed.get("available"):

            status = (
                "DATA RECEIVED"
                if feed.get("records", 0) > 0
                else "EMPTY RESPONSE"
            )

            records = feed.get(
                "records",
                0
            )

        else:

            status = "DATA UNAVAILABLE"

            records = None

        rows.append({
            "Source": feed.get("source"),

            "Status": status,

            "Records": records,

            "Report Date": feed.get(
                "date",
                "Inspect records"
            ),

            "Checked": feed.get(
                "checked",
                ""
            ),

            "Error": feed.get(
                "error",
                ""
            )
        })

    df = pd.DataFrame(rows)

    st.subheader(
        "Intelligence Source Coverage"
    )

    available = sum(
        bool(f.get("available"))
        for f in feeds
    )

    unavailable = (
        len(feeds) - available
    )

    a, b, c = st.columns(3)

    a.metric(
        "Sources",
        len(feeds)
    )

    b.metric(
        "Available",
        available
    )

    c.metric(
        "Unavailable",
        unavailable
    )

    st.dataframe(
        df,
        hide_index=True,
        use_container_width=True
    )

    st.download_button(
        "Download Source Diagnostics",
        df.to_csv(index=False),
        "nse_intelligence_diagnostics.csv",
        key="intel_source_diagnostics_v861"
    )


