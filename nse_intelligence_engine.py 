        "error": error,
        "checked": now().isoformat(),
        "diagnostics": diagnostics or {}
    }


# =====================================
# SECURE HTTP ENGINE
# =====================================

def validate_url(url, allowed_hosts):

    parsed = urlparse(url)

    if parsed.scheme != "https":
        raise RuntimeError(
            "Only HTTPS connections permitted"
        )

    if parsed.hostname not in allowed_hosts:
        raise RuntimeError(
            "Unsafe redirect destination | Host: "
            + str(parsed.hostname)
        )

    if parsed.username or parsed.password:
        raise RuntimeError(
            "URL credentials not permitted"
        )

    if parsed.port not in (None, 443):
        raise RuntimeError(
            "Unsafe destination port"
        )

    return parsed


def secure_get(
    url,
    params=None,
    headers=None,
    timeout=(5, 20),
    diagnostics=None
):

    diagnostics = (
        diagnostics
        if diagnostics is not None
        else {}
    )

    parsed = urlparse(url)

    if parsed.hostname in NSE_HOSTS:
        allowed = NSE_HOSTS

    elif parsed.hostname in UPSTOX_HOSTS:
        allowed = UPSTOX_HOSTS

    else:
        raise RuntimeError(
            "Unknown source host"
        )

    validate_url(url, allowed)

    request_headers = dict(
        headers or HEADERS
    )

    has_token = any(
        k.lower() == "authorization"
        for k in request_headers
    )

    if has_token and allowed != UPSTOX_HOSTS:
        raise RuntimeError(
            "Authorization header restricted "
            "to Upstox"
        )

    diagnostics.update({
        "Initial URL": url,
        "Redirects": [],
        "HTTP Status": None,
        "Final URL": "",
        "Final Host": "",
        "Content Type": ""
    })

    current_url = url
    current_params = params

    with requests.Session() as session:

        for attempt in range(MAX_REDIRECTS + 1):

            validate_url(
                current_url,
                allowed
            )

            response = session.get(
                current_url,
                params=current_params,
                headers=request_headers,
                timeout=timeout,
                allow_redirects=False
            )

            diagnostics["HTTP Status"] = (
                response.status_code
            )

            diagnostics["Final URL"] = (
                response.url
            )

            diagnostics["Final Host"] = (
                urlparse(response.url).hostname
            )

            diagnostics["Content Type"] = (
                response.headers.get(
                    "Content-Type", ""
                )
            )

            if response.status_code in REDIRECT_CODES:

                location = response.headers.get(
                    "Location"
                )

                if not location:
                    raise RuntimeError(
                        "Redirect location missing"
                    )

                next_url = urljoin(
                    response.url,
                    location
                )

                diagnostics["Redirects"].append({
                    "Status": response.status_code,
                    "From": response.url,
                    "To": next_url
                })

                validate_url(
                    next_url,
                    allowed
                )

                if attempt >= MAX_REDIRECTS:
                    raise RuntimeError(
                        "Maximum redirects exceeded"
                    )

                current_url = next_url
                current_params = None

                response.close()
                continue

            if response.status_code != 200:
                raise RuntimeError(
                    f"HTTP {response.status_code}"
                    f" | Host: "
                    f"{diagnostics['Final Host']}"
                )

            return response

    raise RuntimeError(
        "Request did not complete"
    )


def get_json(
    url,
    params=None,
    headers=None,
    diagnostics=None
):

    response = secure_get(
        url,
        params=params,
        headers=headers,
        timeout=(5, 15),
        diagnostics=diagnostics
    )

    try:
        return response.json()

    except ValueError:
        raise RuntimeError(
            "Invalid JSON response"
        )

    finally:
        response.close()


# =====================================
# RESPONSE SCHEMA VALIDATION
# =====================================

def extract_rows(data):

    if isinstance(data, list):
        rows = data

    elif isinstance(data, dict):

        rows = None

        for key in (
            "data",
            "Table",
            "bulkDeals",
            "blockDeals",
            "bulk_deals",
            "block_deals"
        ):

            if isinstance(data.get(key), list):

                rows = data[key]
                break

        if rows is None:
            raise ValueError(
                "Unknown response schema"
            )

    else:
        raise ValueError(
            "Invalid response format"
        )

    if not all(
        isinstance(x, dict)
        for x in rows
    ):
        raise ValueError(
            "Invalid record schema"
        )

    return rows


