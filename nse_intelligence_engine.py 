        "Upstox Company News"
    )

    if universe and token:

        symbols = st.multiselect(
            "Select stocks",
            sorted(universe),
            max_selections=30,
            key="intel_news_symbols"
        )

        if st.button(
            "FETCH COMPANY NEWS",
            key="intel_upstox_news"
        ):

            keys = [
                universe[s]
                for s in symbols
            ]

            with st.spinner(
                "Fetching company news..."
            ):

                st.session_state[
                    "intel_up_news"
                ] = upstox_news(
                    token,
                    keys
                )

        news = st.session_state.get(
            "intel_up_news"
        )

        if news:

            if news["error"]:

                st.warning(
                    news["error"]
                )

            if news["available"]:

                st.success(
                    "News response received"
                )

            elif news["records"] > 0:

                st.warning(
                    "PARTIAL NEWS DATA"
                )

            else:

                st.error(
                    "NEWS DATA UNAVAILABLE"
                )

            st.metric(
                "News Records Received",
                news["records"]
            )

            frame = pd.DataFrame(
                news["items"]
            )

            if not frame.empty:

                st.dataframe(
                    frame,
                    use_container_width=True
                )

                st.download_button(
                    "Download Upstox News",
                    frame.to_csv(
                        index=False
                    ),
                    "upstox_company_news.csv",
                    key="intel_news_download"
                )

    else:

        st.info(
            "Upstox token and instrument "
            "universe required."
        )

    st.divider()

    st.info(
        "Research only. Intelligence records "
        "do not automatically change "
        "live trading scores."
    )

    st.caption(
        "NSE Intelligence Engine V"
        + VERSION
        + " | Redirect Protection"
        + " | Source Diagnostics"
        + " | Historical Report Validation"
        + " | No Automatic Orders"
    )
