def result(source, rows=None, error=""):

    rows = rows if rows is not None else []

    return {
        "source": source,
        "available": not bool(error),
        "records": len(rows),
        "items": rows,
        "error": error,
        "checked": now().isoformat()
    }


# =====================================
# SAFE HTTP REQUEST ENGINE
# =====================================

def safe_request(
    url,
    params=None,
    headers=None,
    timeout=(5, 15)
):

    request_headers = dict(
        headers or HEADERS
    )

    current_url = url

    initial = urlparse(url)

    redirects = []

    authenticated = any(
        str(k).lower() == "authorization"
        for k in request_headers
    )

    with requests.Session() as session:

        for attempt in range(6):

            parsed = urlparse(current_url)

            if (
                parsed.scheme != "https"
                or parsed.hostname not in ALLOWED_HOSTS
                or parsed.username
                or parsed.password
                or parsed.port not in (None, 443)
            ):

                raise RuntimeError(
                    "Unsafe redirect destination | "
                    f"Host: {parsed.hostname}"
                )

            if (
                authenticated
                and parsed.hostname != initial.hostname
            ):

                raise RuntimeError(
                    "Cross-domain token redirect blocked"
                )

            if (
                initial.hostname != "api.upstox.com"
                and parsed.hostname == "api.upstox.com"
            ):

                raise RuntimeError(
                    "Unexpected provider redirect"
                )

            if (
                initial.hostname == "api.upstox.com"
                and parsed.hostname != "api.upstox.com"
            ):

                raise RuntimeError(
                    "Unexpected Upstox redirect"
                )

            response = session.get(
                current_url,
                params=params if attempt == 0 else None,
                headers=request_headers,
                timeout=timeout,
                allow_redirects=False
            )

            if response.status_code in REDIRECT_CODES:

                location = response.headers.get(
                    "Location"
                )

                if not location:

                    raise RuntimeError(
                        "Redirect location missing"
                    )

                next_url = urljoin(
                    response.url,
                    location
                )

                next_parsed = urlparse(next_url)

                redirects.append({
                    "Status": response.status_code,
                    "From": parsed.hostname,
                    "To": next_parsed.hostname,
                    "Path": next_parsed.path
                })

                current_url = next_url

                continue

            if response.status_code != 200:

                raise RuntimeError(
                    f"HTTP {response.status_code} | "
                    f"Host: {parsed.hostname} | "
                    f"Path: {parsed.path} | "
                    f"Redirects: {redirects}"
                )

            return response, redirects

    raise RuntimeError(
        "Maximum redirect limit exceeded | "
        f"Redirects: {redirects}"
    )


# =====================================
# JSON RESPONSE VALIDATION
# =====================================

def get_json(
    url,
    params=None,
    headers=None
):

    response, redirects = safe_request(
        url,
        params=params,
        headers=headers,
        timeout=(5, 15)
    )

    final = urlparse(response.url)

    try:

        data = response.json()

    except ValueError:

        raise RuntimeError(
            "HTTP 200 but invalid JSON | "
            f"Host: {final.hostname} | "
            f"Path: {final.path} | "
            f"Redirects: {redirects}"
        )

    if not isinstance(data, (dict, list)):

        raise ValueError(
            "Unexpected JSON schema"
        )

    return data


def extract_rows(data):

    if isinstance(data, list):

        rows = data

    elif isinstance(data, dict):

        rows = None

        for key in (
            "data",
            "Table",
            "bulkDeals",
            "blockDeals",
            "bulk_deals",
            "block_deals"
        ):

            if isinstance(data.get(key), list):

                rows = data[key]

                break

        if rows is None:

            raise ValueError(
                "Unknown response schema"
            )

    else:

        raise ValueError(
            "Invalid response"
        )

    if not all(
        isinstance(x, dict)
        for x in rows
    ):

        raise ValueError(
            "Invalid record schema"
        )

    return rows


