# =====================================
# HISTORICAL REPORT DOWNLOADER
# =====================================

def download_report(url):

    response = requests.get(
        url,
        headers=HEADERS,
        timeout=(5, 25),
        allow_redirects=False
    )

    if response.status_code != 200:

        raise RuntimeError(
            f"HTTP {response.status_code}"
        )

    content = response.content

    if len(content) > 100_000_000:

        raise ValueError(
            "Report too large"
        )

    if content[:2] == b"PK":

        with zipfile.ZipFile(
            io.BytesIO(content)
        ) as archive:

            files = [
                x for x in archive.infolist()
                if x.filename.lower().endswith(
                    ".csv"
                )
            ]

            if not files:

                raise ValueError(
                    "CSV not found"
                )

            if files[0].file_size > 100_000_000:

                raise ValueError(
                    "Report too large"
                )

            with archive.open(files[0]) as file:

                df = pd.read_csv(
                    file,
                    low_memory=False
                )

    else:

        if content.lstrip().startswith(b"<"):

            raise ValueError(
                "HTML returned instead of CSV"
            )

        df = pd.read_csv(
            io.BytesIO(content),
            low_memory=False
        )

    df.columns = [
        str(c).strip().upper()
        for c in df.columns
    ]

    return df


# =====================================
# NSE CM AND FO BHAVCOPY
# =====================================

@st.cache_data(
    ttl=3600,
    show_spinner=False
)
def bhavcopy(
    date,
    segment="CM"
):

    segment = segment.upper()

    if segment not in ("CM", "FO"):

        raise ValueError(
            "Invalid segment"
        )

    d = date.strftime("%Y%m%d")

    url = (
        ARC
        + f"/content/{segment.lower()}/"
        + f"BhavCopy_NSE_{segment}_0_0_0_"
        + f"{d}_F_0000.csv.zip"
    )

    source = (
        "NSE " + segment + " Bhavcopy"
    )

    try:

        df = download_report(url)

        required = {
            "TCKRSYMB",
            "TRADDT",
            "CLSPRIC"
        }

        if segment == "FO":

            required.add(
                "OPNINTRST"
            )

        if not required.issubset(df.columns):

            raise ValueError(
                "Schema mismatch"
            )

        dates = pd.to_datetime(
            df["TRADDT"],
            errors="coerce"
        ).dt.date

        if (
            df.empty
            or not dates.eq(date).all()
        ):

            raise ValueError(
                "Report date mismatch"
            )

        return {
            "source": source,
            "available": True,
            "records": len(df),
            "date": str(date),
            "data": df,
            "error": "",
            "checked": now().isoformat()
        }

    except Exception as exc:

        return {
            "source": source,
            "available": False,
            "records": 0,
            "date": str(date),
            "data": pd.DataFrame(),
            "error": str(exc),
            "checked": now().isoformat()
        }


