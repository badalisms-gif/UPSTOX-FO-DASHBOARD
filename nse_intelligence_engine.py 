# NSE CM AND FO BHAVCOPY
# =====================================

@st.cache_data(
    ttl=3600,
    show_spinner=False
)
def bhavcopy(
    date,
    segment="CM"
):

    segment = segment.upper()

    if segment not in ("CM", "FO"):
        raise ValueError(
            "Invalid segment"
        )

    d = date.strftime("%Y%m%d")

    url = (
        ARC
        + f"/content/{segment.lower()}/"
        + f"BhavCopy_NSE_{segment}_0_0_0_"
        + f"{d}_F_0000.csv.zip"
    )

    source = (
        "NSE " + segment + " Bhavcopy"
    )

    diagnostics = {}

    try:

        df = download_report(
            url,
            diagnostics
        )

        required = {
            "TCKRSYMB",
            "TRADDT",
            "CLSPRIC"
        }

        if segment == "FO":
            required.add(
                "OPNINTRST"
            )

        if not required.issubset(
            df.columns
        ):
            raise ValueError(
                "Bhavcopy schema mismatch"
            )

        dates = pd.to_datetime(
            df["TRADDT"],
            errors="coerce"
        ).dt.date

        if (
            df.empty
            or not dates.eq(date).all()
        ):
            raise ValueError(
                "Bhavcopy report date mismatch"
            )

        return report_result(
            source,
            date,
            df,
            diagnostics=diagnostics
        )

    except Exception as e:

        return report_result(
            source,
            date,
            error=str(e),
            diagnostics=diagnostics
        )


