    source = "NSE " + kind + " Deals"

    diagnostics = {}

    try:

        data = get_json(
            NSE + endpoint,
            {
                "from": start_date.strftime(
                    "%d-%m-%Y"
                ),
                "to": end_date.strftime(
                    "%d-%m-%Y"
                )
            },
            diagnostics=diagnostics
        )

        return result(
            source,
            extract_rows(data),
            diagnostics=diagnostics
        )

    except Exception as e:

        return result(
            source,
            error=str(e),
            diagnostics=diagnostics
        )


# =====================================
# HISTORICAL REPORT DOWNLOADER
# =====================================

def download_report(
    url,
    diagnostics=None
):

    response = secure_get(
        url,
        timeout=(5, 30),
        diagnostics=diagnostics
    )

    try:
        content = response.content
    finally:
        response.close()

    if len(content) > MAX_REPORT_SIZE:
        raise ValueError(
            "Report exceeds size limit"
        )

    if content[:2] == b"PK":

        with zipfile.ZipFile(
            io.BytesIO(content)
        ) as archive:

            files = [
                x for x in archive.infolist()
                if x.filename.lower().endswith(
                    ".csv"
                )
            ]

            if not files:
                raise ValueError(
                    "CSV not found"
                )

            if files[0].file_size > MAX_REPORT_SIZE:
                raise ValueError(
                    "Uncompressed report too large"
                )

            with archive.open(files[0]) as f:

                df = pd.read_csv(
                    f,
                    low_memory=False
                )

    else:

        df = pd.read_csv(
            io.BytesIO(content),
            low_memory=False
        )

    df.columns = [
        str(c).strip().upper()
        for c in df.columns
    ]

    return df


def report_result(
    source,
    date,
    frame=None,
    error="",
    diagnostics=None
):

    if frame is None:
        frame = pd.DataFrame()

    return {
        "source": source,
        "available": not bool(error),
        "records": (
            len(frame)
            if not error else None
        ),
        "date": str(date),
        "data": frame,
        "error": error,
        "checked": now().isoformat(),
        "diagnostics": diagnostics or {}
    }


