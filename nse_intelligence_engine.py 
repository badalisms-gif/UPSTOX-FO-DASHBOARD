# =====================================
# SHORT SELLING CSV VALIDATION
# =====================================

def short_selling_csv(upload):

    if upload is None:

        return {
            "available": False,
            "records": None,
            "data": pd.DataFrame(),
            "error": "Official CSV required"
        }

    try:

        df = pd.read_csv(upload)

        df.columns = [
            str(c).strip().upper()
            for c in df.columns
        ]

        symbol_col = next(
            (
                c for c in df.columns
                if c in (
                    "SYMBOL",
                    "SECURITY SYMBOL"
                )
            ),
            None
        )

        qty_col = next(
            (
                c for c in df.columns
                if "QTY" in c
                or "QUANTITY" in c
            ),
            None
        )

        date_col = next(
            (
                c for c in df.columns
                if "DATE" in c
            ),
            None
        )

        if not all([
            symbol_col,
            qty_col,
            date_col
        ]):
            raise ValueError(
                "Unrecognized short selling schema"
            )

        df["REPORT_DATE"] = pd.to_datetime(
            df[date_col],
            dayfirst=True,
            errors="coerce"
        ).dt.date

        df["SHORT_QTY"] = pd.to_numeric(
            df[qty_col]
            .astype(str)
            .str.replace(",", "", regex=False),
            errors="coerce"
        )

        df["STOCK_SYMBOL"] = (
            df[symbol_col]
            .astype(str)
            .str.strip()
            .str.upper()
        )

        if (
            df.empty
            or df["REPORT_DATE"].isna().any()
            or df["SHORT_QTY"].isna().any()
            or (df["SHORT_QTY"] < 0).any()
            or (
                df["REPORT_DATE"] > now().date()
            ).any()
        ):
            raise ValueError(
                "Invalid short selling records"
            )

        return {
            "available": True,
            "records": len(df),
            "data": df,
            "error": "",
            "date": str(
                df["REPORT_DATE"].max()
            )
        }

    except Exception as e:

        return {
            "available": False,
            "records": None,
            "data": pd.DataFrame(),
            "error": str(e)
        }


# =====================================
# UPSTOX COMPANY NEWS
# =====================================

def upstox_news(
    token,
    instrument_keys
):

    if not token:

        return result(
            "Upstox News",
            error="Access token required"
        )

    keys = list(
        dict.fromkeys(instrument_keys)
    )

    if not keys:

        return result(
            "Upstox News",
            error="No instruments selected"
        )

    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/json"
    }

    rows = []
    errors = []
    diagnostics = {}

    for i in range(
        0,
        len(keys),
        30
    ):

        batch = keys[i:i + 30]

        try:

            complete = False

            for page in range(1, 4):

                data = get_json(
                    UP + "/v2/news",
                    {
                        "category": "instrument_keys",
                        "instrument_keys": ",".join(
                            batch
                        ),
                        "page_number": page,
                        "page_size": 100
                    },
                    headers=headers,
                    diagnostics=diagnostics
                )

                mapping = data.get(
                    "data", {}
                )

                if (
                    data.get("status") != "success"
                    or not isinstance(mapping, dict)
                ):
                    raise ValueError(
                        "Invalid news response"
                    )

                for key, articles in mapping.items():

                    if key not in batch:
                        continue

                    if not isinstance(
                        articles, list
                    ):
                        continue

                    for article in articles:

                        if not isinstance(
                            article, dict
                        ):
                            continue

                        rows.append({
                            "Instrument": key,

                            "Heading": article.get(
                                "heading", ""
                            ),

                            "Summary": article.get(
                                "summary", ""
                            ),

                            "Published": article.get(
                                "published_time"
                            ),

                            "URL": article.get(
                                "article_link", ""
                            ),

                            "Impact": "REVIEW REQUIRED"
                        })

                pages = data.get(
                    "metadata", {}
                ).get(
                    "page", {}
                ).get(
                    "total_pages"
                )

                if pages is not None:

                    if page >= int(pages):

                        complete = True
                        break

                else:
                    break

            if not complete:

                errors.append(
                    f"Batch {i // 30 + 1}: "
                    "Pagination unverified"
                )

        except Exception as e:

            message = str(e).replace(
                token,
                "[REDACTED]"
            )

            errors.append(
                f"Batch {i // 30 + 1}: "
                + message
            )

    if rows:

        df = pd.DataFrame(rows)

        df = df.drop_duplicates(
            subset=[
                "Instrument",
                "Heading",
                "Published"
            ]
        )

        rows = df.to_dict("records")

    return result(
        "Upstox News",
        rows,
        "; ".join(errors),
        diagnostics
    )


# =====================================
# SOURCE COVERAGE DIAGNOSTICS
# =====================================

def source_status(feed):

    if not feed.get("available"):

        return "DATA UNAVAILABLE"

    if feed.get("records") == 0:

        return "NO RECORDS RETURNED"

    return "DATA RECEIVED"


def diagnostics_frame(feeds):

    rows = []

    for feed in feeds:

        diag = feed.get(
            "diagnostics", {}
        )

        rows.append({
            "Source": feed.get(
                "source", ""
            ),

            "Status": source_status(feed),

            "Records": feed.get(
                "records"
            ),

            "Report Date": feed.get(
                "date",
                "Inspect records"
            ),

            "Checked": feed.get(
                "checked", ""
            ),

            "HTTP Status": diag.get(
                "HTTP Status"
            ),

            "Final Host": diag.get(
                "Final Host", ""
            ),

            "Initial URL": diag.get(
                "Initial URL", ""
            ),

            "Final URL": diag.get(
                "Final URL", ""
            ),

            "Content Type": diag.get(
                "Content Type", ""
            ),

            "Redirect Count": len(
                diag.get("Redirects", [])
            ),

            "Redirect History": str(
                diag.get("Redirects", [])
            ),

            "Error": feed.get(
                "error", ""
            )
        })

    return pd.DataFrame(rows)


# =====================================
# REFRESH OFFICIAL SOURCES
# =====================================

def refresh_sources(date):

    # Clear only intelligence caches.
    # Existing live scanner remains untouched.

    announcements.clear()
    pre_open.clear()
    deals.clear()
    bhavcopy.clear()
    delivery.clear()

    tasks = [
        (
            "NSE Announcements",
            lambda: announcements()
        ),
        (
            "NSE Pre Open",
            lambda: pre_open()
        ),
        (
            "NSE BULK Deals",
            lambda: deals(
                "BULK",
                date - timedelta(days=7),
                date
            )
        ),
        (
            "NSE BLOCK Deals",
            lambda: deals(
                "BLOCK",
                date - timedelta(days=7),
                date
            )
        ),
        (
            "NSE CM Bhavcopy",
            lambda: bhavcopy(
                date, "CM"
            )
        ),
        (
            "NSE FO Bhavcopy",
            lambda: bhavcopy(
                date, "FO"
            )
        ),
        (
            "NSE Delivery",
            lambda: delivery(date)
        )
    ]

    feeds = []

    progress = st.progress(0)
    status = st.empty()

    for i, (name, function) in enumerate(
        tasks
    ):

        status.caption(
            "Checking " + name
        )

        try:

            feed = function()

        except Exception as e:

            feed = result(
                name,
                error=str(e)
            )

        feeds.append(feed)

        progress.progress(
            (i + 1) / len(tasks)
        )

    progress.empty()
    status.empty()

    return feeds


# =====================================
# SOURCE COVERAGE DISPLAY
# =====================================

def render_source_coverage(feeds):

    if not feeds:
        return

    st.subheader(
        "NSE Source Coverage"
    )

    available = sum(
        bool(x.get("available"))
        for x in feeds
    )

    unavailable = (
        len(feeds) - available
    )

    total_records = sum(
        x.get("records") or 0
        for x in feeds
        if x.get("available")
    )

    a, b, c = st.columns(3)

    a.metric(
        "Available Sources",
        f"{available}/{len(feeds)}"
    )

    b.metric(
        "Records Received",
        total_records
    )

    c.metric(
        "Unavailable",
        unavailable
    )

    if unavailable:

        st.warning(
            "Some NSE sources are unavailable. "
            "Unavailable data is not treated "
            "as zero market activity."
        )

    diagnostics = diagnostics_frame(
        feeds
    )

    st.dataframe(
        diagnostics,
        hide_index=True,
        use_container_width=True
    )

    st.download_button(
        "Download Source Diagnostics",
        diagnostics.to_csv(index=False),
        "nse_source_diagnostics_v862.csv",
        mime="text/csv",
        key="intel_diagnostics_v862"
    )


# =====================================
# INDIVIDUAL SOURCE DISPLAY
# =====================================

def render_feed(feed):

    status = source_status(feed)

    if feed.get("available"):

        label = (
            feed["source"]
            + " | "
            + str(feed.get("records", 0))
            + " Records"
        )

    else:

        label = (
            feed["source"]
            + " | DATA UNAVAILABLE"
        )

    with st.expander(label):

        if status == "DATA RECEIVED":

            st.success(
                "Data received"
            )

        elif status == "NO RECORDS RETURNED":

            st.info(
                "Valid response returned "
                "no records. Coverage and "
                "report timing must be checked."
            )

        else:

            st.error(
                feed.get(
                    "error",
                    "Unknown source error"
                )
            )

        st.caption(
            "Report date: "
            + feed.get(
                "date",
                "Inspect individual records"
            )
        )

        st.caption(
            "Checked: "
            + feed.get("checked", "")
        )

        diag = feed.get(
            "diagnostics", {}
        )

        if diag:

            st.write(
                "HTTP Status:",
                diag.get("HTTP Status")
            )

            st.write(
                "Final Host:",
                diag.get("Final Host")
            )

            st.write(
                "Final URL:",
                diag.get("Final URL")
            )

            st.write(
                "Content Type:",
                diag.get("Content Type")
            )

            if diag.get("Redirects"):

                st.write(
                    "Redirect History"
                )

                st.json(
                    diag["Redirects"]
                )

        frame = feed.get("data")

        if frame is None:

            frame = pd.DataFrame(
                feed.get("items", [])
            )

        if not frame.empty:

            st.dataframe(
                frame,
                use_container_width=True
            )

            st.download_button(
                "Download " + feed["source"],
                frame.to_csv(index=False),
                feed["source"].replace(
                    " ", "_"
                ) + ".csv",
                mime="text/csv",
                key=(
                    "intel_v862_"
                    + feed["source"]
                )
            )


# =====================================
# MAIN INTELLIGENCE DASHBOARD
# =====================================

def render_intelligence(
    token="",
    universe=None
):

    st.header(
        "NSE MARKET INTELLIGENCE V"
        + VERSION
    )

    st.caption(
        "Official market data research | "
        "Secure NSE domain redirects | "
        "No automatic orders"
    )

    st.success(
        "Intelligence Engine V"
        + VERSION
        + " Loaded"
    )

    st.caption(
        "Primary NSE domain: "
        + NSE
    )

    st.warning(
        "Historical reports are not live data. "
        "Bulk deals, block deals, delivery "
        "and short selling do not independently "
        "establish CE/PE direction."
    )

    with st.expander(
        "Connection Configuration"
    ):

        st.write(
            "Engine Version:",
            VERSION
        )

        st.write(
            "NSE:",
            NSE
        )

        st.write(
            "NSE Archives:",
            ARC
        )

        st.write(
            "Upstox:",
            UP
        )

        st.write(
            "Allowed NSE Domains:",
            sorted(NSE_HOSTS)
        )

        st.write(
            "Maximum Redirects:",
            MAX_REDIRECTS
        )

        st.caption(
            "Upstox authorization is restricted "
            "to the Upstox API host."
        )

    default_date = (
        now().date()
        - timedelta(days=1)
    )

    while default_date.weekday() >= 5:

        default_date -= timedelta(days=1)

    date = st.date_input(
        "Historical Report Date",
        default_date,
        max_value=now().date(),
        key="intel_report_date"
    )

    if st.button(
        "REFRESH NSE INTELLIGENCE",
        type="primary",
        key="intel_refresh"
    ):

        with st.spinner(
            "Checking official market sources..."
        ):

            st.session_state[
                "intel_feeds"
            ] = refresh_sources(date)

            st.session_state[
                "intel_refresh_version"
            ] = VERSION

            st.session_state[
                "intel_selected_date"
            ] = str(date)

    feeds = st.session_state.get(
        "intel_feeds",
        []
    )

    refresh_version = (
        st.session_state.get(
            "intel_refresh_version"
        )
    )

    if feeds and refresh_version != VERSION:

        st.warning(
            "Previous engine data detected. "
            "Press REFRESH NSE INTELLIGENCE "
            "to test the new version."
        )

        feeds = []

    if feeds:

        selected_date = (
            st.session_state.get(
                "intel_selected_date"
            )
        )

        if selected_date != str(date):

            st.warning(
                "Selected date changed. "
                "Refresh to load the new date."
            )

        render_source_coverage(feeds)

        for feed in feeds:

            render_feed(feed)

    else:

        st.info(
            "Press REFRESH NSE INTELLIGENCE "
            "to check all seven sources."
        )

    # =================================
    # SHORT SELLING
    # =================================

    st.divider()

    st.subheader(
        "NSE Short Selling"
    )

    st.caption(
        "Official report upload required. "
        "Automatic short selling feed "
        "is not yet verified."
    )

    upload = st.file_uploader(
        "Official NSE Short Selling CSV",
        type=["csv"],
        key="intel_short_csv"
    )

    if upload is not None:

        short = short_selling_csv(
            upload
        )

        if short["available"]:

            st.metric(
                "Short Selling Records",
                short["records"]
            )

            st.caption(
                "Latest report date: "
                + short["date"]
            )

            st.dataframe(
                short["data"],
                use_container_width=True
            )

            st.download_button(
                "Download Validated Short Selling",
                short["data"].to_csv(
                    index=False
                ),
                "validated_short_selling.csv",
                mime="text/csv",
                key="short_download_v862"
            )

        else:

            st.error(
                short["error"]
            )

    # =================================
    # UPSTOX COMPANY NEWS
    # =================================

    st.divider()

    st.subheader(
        "Upstox Company News"
    )

    if universe and token:

        symbols = st.multiselect(
            "Select stocks",
            sorted(universe),
            max_selections=30,
            key="intel_news_symbols"
        )

        if st.button(
            "FETCH COMPANY NEWS",
            key="intel_upstox_news"
        ):

            if not symbols:

                st.warning(
                    "Select at least one stock"
                )

            else:

                keys = [
                    universe[s]
                    for s in symbols
                ]

                with st.spinner(
                    "Fetching Upstox company news..."
                ):

                    st.session_state[
                        "intel_up_news"
                    ] = upstox_news(
                        token,
                        keys
                    )

        news = st.session_state.get(
            "intel_up_news"
        )

        if news:

            if news.get("error"):

                st.warning(
                    news["error"]
                )

            items = news.get(
                "items", []
            )

            st.metric(
                "News Records Received",
                len(items)
            )

            st.caption(
                "Checked: "
                + news.get("checked", "")
            )

            if items:

                frame = pd.DataFrame(
                    items
                )

                reverse = {
                    value: key
                    for key, value
                    in universe.items()
                }

                if "Instrument" in frame:

                    frame.insert(
                        0,
                        "Symbol",
                        frame["Instrument"].map(
                            reverse
                        )
                    )

                st.dataframe(
                    frame,
                    use_container_width=True
                )

                st.download_button(
                    "Download Company News",
                    frame.to_csv(index=False),
                    "upstox_company_news.csv",
                    mime="text/csv",
                    key="up_news_download_v862"
                )

            elif not news.get("error"):

                st.info(
                    "No news records returned."
                )

    else:

        st.info(
            "Upstox token and F&O universe "
            "required for company news."
        )

    # =================================
    # SAFETY FOOTER
    # =================================

    st.divider()

    st.info(
        "Research only. Intelligence records "
        "do not automatically change the "
        "live trading score. Unavailable "
        "sources are not assumed neutral."
    )

    st.caption(
        "NSE Intelligence V"
        + VERSION
        + " | Secure Redirects"
        + " | Source Diagnostics"
        + " | Historical Date Validation"
        + " | No Automatic Orders"
    )
